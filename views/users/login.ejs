<% layout('layout/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/auth.css">

<div class="auth-container">
    <div class="auth-card-horizontal floating">
        <div class="row g-0">
            <!-- Image Section -->
            <div class="col-md-5">
                <div class="auth-image-section">
                    <img src="https://images.unsplash.com/photo-1571863533956-01c88e79957e?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1267&q=80"
                        alt="Login Background" class="auth-image" />
                    <div class="image-overlay">
                        <div class="overlay-content">
                            <h3>Welcome to Campify</h3>
                            <p>Your gateway to amazing camping experiences</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Form Section -->
            <div class="col-md-7">
                <div class="auth-form-section">
                    <!-- Login Title -->
                    <h4 class="auth-title">
                        <i class="fas fa-sign-in-alt"></i>Welcome Back
                    </h4>

                    <!-- Guest Credentials Info -->
                    <p class="guest-access-text">
                        Quick Access: <code>example</code> / <code>12345</code>
                    </p>

                    <!-- Login Form -->
                    <form action="/login" method="POST" class="validated-form" novalidate>
                        <div class="form-group">
                            <label for="username" class="form-label">
                                <i class="fas fa-user"></i>
                                Username
                            </label>
                            <input type="text" 
                                   class="form-input" 
                                   id="username" 
                                   name="username" 
                                   placeholder="Enter your username"
                                   required>
                            <div class="valid-feedback">
                                <i class="fas fa-check"></i>
                                Looks good!
                            </div>
                            <div class="invalid-feedback">
                                Please provide a valid username.
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="password" class="form-label">
                                <i class="fas fa-lock"></i>
                                Password
                            </label>
                            <input type="password" 
                                   class="form-input" 
                                   id="password" 
                                   name="password" 
                                   placeholder="Enter your password"
                                   required>
                            <div class="valid-feedback">
                                <i class="fas fa-check"></i>
                                Looks good!
                            </div>
                            <div class="invalid-feedback">
                                Please provide a valid password.
                            </div>
                        </div>

                        <button type="submit" class="auth-submit-btn">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Login
                        </button>
                    </form>

                    <!-- Register Link -->
                    <div class="text-center mt-3 pt-2" style="border-top: 1px solid #e0e0e0;">
                        <p class="mb-0" style="color: #6c757d; font-size: 0.9rem;">
                            Don't have an account? 
                            <a href="/register" style="color: var(--primary-color); text-decoration: none; font-weight: 600;">
                                Register here
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/javascripts/auth-validation.js"></script>