<% layout('layout/boilerplate') %>

<!-- Full Screen Home Page -->
<div class="home-hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="container text-center">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <!-- Logo/Brand -->
                    <div class="home-brand mb-4">
                        <i class="fas fa-mountain"></i>
                        <h1>Campify</h1>
                    </div>
                    
                    <!-- Main heading -->
                    <h2 class="hero-title">Discover Amazing Campgrounds</h2>
                    <p class="hero-subtitle">Find your perfect outdoor adventure and connect with nature. Explore handpicked camping destinations across the world.</p>
                    
                    <!-- Call to action buttons -->
                    <div class="hero-buttons">
                        <a href="/campgrounds" class="btn btn-hero-primary">
                            <i class="fas fa-compass me-2"></i>
                            View Campgrounds
                        </a>
                        <a href="/register" class="btn btn-hero-secondary">
                            <i class="fas fa-user-plus me-2"></i>
                            Join Community
                        </a>
                    </div>
                    
                    <!-- Quick stats -->
                    <div class="hero-stats">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="stat-item">
                                    <div class="stat-number">500+</div>
                                    <div class="stat-label">Campgrounds</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-item">
                                    <div class="stat-number">1000+</div>
                                    <div class="stat-label">Happy Campers</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-item">
                                    <div class="stat-number">50+</div>
                                    <div class="stat-label">Countries</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Login link in corner -->
    <div class="home-login-link">
        <a href="/login" class="login-corner-btn">
            <i class="fas fa-sign-in-alt me-2"></i>
            Login
        </a>
    </div>

    <!-- Made By Credit Footer -->
    <div class="home-footer-credit">
      <div class="creator-credit">
          <span>Crafted with </span>
          <i class="fas fa-heart text-danger"></i>
          <span> by </span>
          <a href="https://www.linkedin.com/in/mandartule/" 
             target="_blank" 
             class="home-creator-link">
              <i class="fab fa-linkedin me-1"></i>Mandar Tule
          </a>
      </div>
  </div>
</div>