<!DOCTYPE html>
<html lang="en" data-bs-theme="grey">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campify</title>
    <link rel="shortcut icon" href="#">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/theme.css">
    <!-- mapbox -->
    <script src='https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js'></script>
    <link href='https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css' rel='stylesheet' />
    <!-- Search functionality -->
    <script src="/javascripts/search.js"></script>
</head>

<body class="d-flex flex-column vh-100 <%= typeof isHomePage !== 'undefined' && isHomePage ? 'home-page' : '' %>">
    <!-- Only show navbar if NOT home page -->
    <% if (typeof isHomePage === 'undefined' || !isHomePage) { %>
        <%- include('../partials/navbar') %>
    <% } %>

    <!-- Main content with conditional container -->
    <% if (typeof isHomePage !== 'undefined' && isHomePage) { %>
        <!-- Full width for home page -->
        <main class="home-main">
            <%-body %>
        </main>
    <% } else { %>
        <!-- Regular container for other pages -->
        <main class="container mt-5">
            <%- include('../partials/flash') %>
            <%-body %>
        </main>
    <% } %>

    <!-- Only show footer if NOT home page -->
    <% if (typeof isHomePage === 'undefined' || !isHomePage) { %>
        <%- include('../partials/footer') %>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="/javascripts/validateForms.js"></script>
    <!-- Add auth validation for login/register pages -->
   
</body>
</html>